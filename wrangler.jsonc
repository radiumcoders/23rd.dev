{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "23rd-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "23rd-dev",
    },
  ],
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    // Test-mode Creem payment links so PR previews can check out.
    // Override with Worker secrets for live products.
    "CREEM_SPONSOR_DIAMOND_CHECKOUT_URL": "https://creem.io/test/product/prod_4ZM6WkQrmCSBtFGCdYp7rZ",
    "CREEM_SPONSOR_PLATINUM_CHECKOUT_URL": "https://creem.io/test/product/prod_7jEvtpKnPoVXOAZLBnoWfA",
    "CREEM_SPONSOR_GOLD_CHECKOUT_URL": "https://creem.io/test/product/prod_MqDtYvXUGlGqgEz898MCA",
    "CREEM_SPONSOR_SILVER_CHECKOUT_URL": "https://creem.io/test/product/prod_3aZ8AxbA2h43IRUMxigep0",
  },
  "observability": {
    "enabled": true,
  },
}
