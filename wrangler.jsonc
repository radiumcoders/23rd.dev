{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "23rd-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "23rd-dev",
    },
  ],
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    // Live Creem payment links. Worker secrets override these vars.
    "CREEM_SPONSOR_DIAMOND_CHECKOUT_URL": "https://www.creem.io/payment/prod_1lz1o8e7HtglOuXbMRnSmc",
    "CREEM_SPONSOR_PLATINUM_CHECKOUT_URL": "https://www.creem.io/payment/prod_4kpDvyYwr6XnRuMSysnI3s",
    "CREEM_SPONSOR_GOLD_CHECKOUT_URL": "https://www.creem.io/payment/prod_2NW3lMTPFHeOey3XhUYlM",
    "CREEM_SPONSOR_SILVER_CHECKOUT_URL": "https://www.creem.io/payment/prod_3uz4xoRD5vVePnDwRIJxoi",
  },
  "observability": {
    "enabled": true,
  },
}
