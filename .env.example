# Next.js (pnpm dev) reads this file as `.env.local`.
# OpenNext / Wrangler preview reads the same keys from `.dev.vars`.
# Production: set them as Cloudflare Worker secrets (see README).

NEXTJS_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Creem hosted payment links from Dashboard → Products → Share.
# Test-mode links work while the dashboard Test Mode toggle is on.
# Leave empty to fall back to mailto:sponsors@23rd.dev.
CREEM_SPONSOR_DIAMOND_CHECKOUT_URL=
CREEM_SPONSOR_PLATINUM_CHECKOUT_URL=
CREEM_SPONSOR_GOLD_CHECKOUT_URL=
CREEM_SPONSOR_SILVER_CHECKOUT_URL=
